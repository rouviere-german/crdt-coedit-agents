# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=crdt-coedit-agents
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run crdt-coedit-agents generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Agentic kit. Tests, demo and bench run offline and never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

APP_DATA_DIR=var

# Synchronization service. The JWT secret signs per-document role tokens; leave it empty to run
# everything offline (the tests, the demo and the benchmarks never need it).
APP_SYNC_JWT_SECRET=
APP_SYNC_TOKEN_TTL_SECONDS=3600
APP_SYNC_DB_PATH=var/oplog.sqlite3
APP_SYNC_AUDIT_PATH=var/audit.jsonl
APP_SYNC_MAX_OPS_PER_PUSH=128
APP_SYNC_MAX_DOCUMENT_BYTES=1048576
APP_SYNC_MAX_CATCH_UP_OPS=4096
APP_SYNC_SUBSCRIBER_QUEUE=256
APP_SYNC_MAX_SUBSCRIBERS_PER_DOC=32
APP_SYNC_MESSAGES_PER_SECOND=50
APP_SYNC_MESSAGE_BURST=200

# Agent replicas.
APP_AGENT_MAX_PLAN_STEPS=12
APP_AGENT_MAX_OPS_PER_SUGGESTION=2000
